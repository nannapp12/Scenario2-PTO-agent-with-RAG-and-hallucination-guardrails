# Local development only. In Azure these come from Key Vault references.
PG_HOST=<server>.postgres.database.azure.com
PG_DATABASE=hr_rag
PG_USER=<your Entra user, e.g. you@contoso.com>
PG_SSLMODE=verify-full
# PG_SSLROOTCERT=C:/path/to/ca-bundle.pem
PII_ENCRYPTION_KEY=<from Key Vault: pii-encryption-key>
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com
CHAT_DEPLOYMENT=gpt-4.1
EMBEDDING_DEPLOYMENT=text-embedding-3-small
# "none" skips sign-in. Only for localhost; never deploy with it.
PTO_AUTH_MODE=none
COMPANY_TIMEZONE=UTC
ALLOWED_ORIGINS=http://localhost:8000
